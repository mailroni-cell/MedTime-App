<?xml version="1.0" encoding="utf-8"?>
<!-- M-357 (owner): no white flash when the app opens: the window (and Android 12+ start screen) is the splash's dark colour -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MedTime" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/mt_dark</item>
        <item name="android:statusBarColor">@color/mt_dark</item>
        <item name="android:navigationBarColor">@color/mt_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/mt_dark</item>
    </style>
    <color name="mt_dark">#0B1026</color>
</resources>
